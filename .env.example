# Environment Configuration for Falcon Research Engine
# Copy to .env and adjust. NEVER commit real API keys.

# Market Data
MARKET_DATA_SOURCE=binance

# Exchange (paper | sandbox | testnet | live). Live requires extra confirmation below.
EXCHANGE_ADAPTER=paper

# Safety: live trading stays DISABLED unless ALL three are set:
# EXCHANGE_ADAPTER=live, LIVE_TRADING_ENABLED=true, LIVE_TRADING_CONFIRM=I_UNDERSTAND_LIVE_RISK
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=

# Logging
LOG_LEVEL=INFO

# Risk Management
MAX_POSITION_SIZE=1000
RISK_PER_TRADE=10
RISK_PER_TRADE_PCT=0.01
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.01
MAX_DAILY_LOSS=500
MAX_CONSECUTIVE_LOSSES=3
STOP_TRADING_COOLDOWN_MINUTES=30
KILL_SWITCH_ENABLED=false
MAX_DRAWDOWN_PERCENTAGE=0.1

# Strategy V1 (EMA + momentum + volume + volatility + spread)
STRATEGY_TYPE=ema_crossover
FAST_EMA_LENGTH=10
SLOW_EMA_LENGTH=20
MIN_VOLUME=1000
MOMENTUM_PERIOD=14
MOMENTUM_THRESHOLD=0.01
VOLATILITY_PERIOD=14
VOLATILITY_MIN=0.0
VOLATILITY_MAX=0.10
MAX_SPREAD_PCT=0.002

# Simulation costs (maker/taker commissions, spread, slippage)
MAKER_FEE=0.001
TAKER_FEE=0.002
SPREAD_PCT=0.0005
SLIPPAGE_PCT=0.0005
SIMULATED_LATENCY_MS=50
PARTIAL_FILL_PROBABILITY=0.0
REJECT_PROBABILITY=0.0

# Liquidity-aware taker execution (bar volume in base-asset units).
# min_fill_notional=0 disables dust rejects (legacy compatible); set >0
# (e.g. 10.0) for realistic insufficient-liquidity rejects.
MAX_PARTICIPATION_RATE=0.10
MIN_FILL_NOTIONAL=0.0
MARKET_IMPACT_COEFF=0.0
DYNAMIC_SPREAD_COEFF=0.0

# Execution model for backtest/replay: next_open | next_close
EXECUTION_MODEL=next_close

# Historical data replay (real OHLCV, never live)
DATA_CSV_PATH=data/sample_ohlcv.csv
DATA_CSV_SYMBOL=BTC/USDT
DATA_CSV_INTERVAL=5m

# Temporal evaluation splits (train/tune vs validation strictly separated)
TRAIN_RATIO=0.6
VALIDATION_RATIO=0.2
WALK_FORWARD_N_SPLITS=3
WALK_FORWARD_TRAIN_BARS=200
WALK_FORWARD_TEST_BARS=100
EMBARGO_BARS=5
# Indicator warmup bars: context only, never scored (no leakage)
WARMUP_BARS=30

# Portfolio / engine
INITIAL_CASH=10000
PAPER_TRADING_ENABLED=true
BACKTEST_ENABLED=false
TRADE_INTERVAL_SECONDS=5
RANDOM_SEED=42
